---
const currentYear = new Date().getFullYear();
---

<footer id="contact" class="bg-primary py-24 md:py-32 md:pl-28">
  <div class="max-w-7xl mx-auto px-8 md:px-16">
    <!-- Main Content -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-16 md:gap-8">
      <!-- Brand & CTA -->
      <div class="md:col-span-6">
        <h3 
          class="text-hero style-heading text-background mb-8 font-chinese"
        >
          光影詩
        </h3>
        <p class="text-body-lg text-background/60 leading-relaxed max-w-md mb-10">
          Available for collaborations, exhibitions, and commissioned work.
        </p>
        <a 
          href="mailto:hello@example.com"
          class="inline-block text-small style-cta text-background border-b border-background/30 pb-1 hover:border-background transition-colors"
        >
          Get in Touch
        </a>
      </div>

      <!-- Contact Info -->
      <div class="md:col-span-3">
        <h4 class="text-body-lg style-label text-background/40 mb-6">
          Contact
        </h4>
        <div class="space-y-4">
          <a 
            href="mailto:hello@example.com" 
            class="block text-body text-background/70 hover:text-background transition-colors"
          >
            hello@example.com
          </a>
          <p class="text-body text-background/50">
            Shanghai, China
          </p>
        </div>
      </div>

      <!-- Social -->
      <div class="md:col-span-3">
        <h4 class="text-body-lg style-label text-background/40 mb-6">
          Follow
        </h4>
        <div class="flex flex-col gap-3">
          <a 
            href="#" 
            class="text-body text-background/50 hover:text-background transition-colors"
          >
            Instagram
          </a>
          <a 
            href="#" 
            class="text-body text-background/50 hover:text-background transition-colors"
          >
            Behance
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-24 pt-8 border-t border-background/10 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <p class="text-label text-background/30">
        &copy; {currentYear} All rights reserved
      </p>
      <p class="text-label text-background/30">
        Crafted with intention
      </p>
    </div>
  </div>
</footer>
