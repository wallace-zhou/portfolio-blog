---
const currentYear = new Date().getFullYear();
---

<footer id="contact" class="bg-primary py-24 md:py-32 md:pl-28">
  <div class="max-w-7xl mx-auto px-8 md:px-16">
    <!-- Main Content -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-16 md:gap-8">
      <!-- Brand & CTA -->
      <div class="md:col-span-6">
        <div id="hero-top-logo" class="flex justify-center py-[26px]">
          <a
            href="/"
            class="header-logo flex flex-col items-center transition-all duration-700"
            aria-label="周庭徵 logo"
          >
            <img
              src="/logo-ztz.svg"
              alt="周庭徵 signature logo"
              class="h-12 md:h-16 w-auto logo-svg"
            />
            <span class="text-background text-body-lg style-label mt-2">Wallace Z</span>
          </a>
        </div>
        
      </div>

      <!-- Contact Info -->
      <div class="md:col-span-3">
        <h4 class="text-body-lg style-label text-background/40 mb-6">
          Contact
        </h4>
        <div class="space-y-4">
          <a 
            href="zhoutingzheng@gmail.com" 
            class="block text-body text-background/70 hover:text-background transition-colors"
          >
          zhoutingzheng@gmail.com
          </a>
          <p class="text-body text-background/50">
            Pittsburgh, PA
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-24 pt-8 border-t border-background/10 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <p class="text-label text-background/30">
        &copy; {currentYear} All rights reserved
      </p>
    </div>
  </div>
</footer>
