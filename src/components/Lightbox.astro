---
import type { PhotoMetadata, PhotoId } from '../data/photos';
import { imageSources } from '../data/photos';
import { Image } from 'astro:assets';

interface Props {
  photos: PhotoMetadata[];
}

const { photos } = Astro.props;

// Pre-compute optimized image URLs for the lightbox
const photoData = photos.map((photo, index) => ({
  id: photo.id,
  title: photo.title,
  location: photo.location,
  exif: photo.exif,
  index,
}));
---

<!-- Lightbox Modal -->
<div 
  id="lightbox" 
  class="fixed inset-0 z-[var(--z-lightbox)] hidden bg-black/95 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Image lightbox"
>
  <!-- Close button -->
  <button 
    id="lightbox-close"
    class="absolute top-4 right-4 z-10 w-10 h-10 flex items-center justify-center text-white/80 hover:text-white transition-colors"
    aria-label="Close lightbox"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- Image counter -->
  <div id="lightbox-counter" class="absolute top-4 left-4 text-white/80 text-sm font-medium z-10">
    <span id="lightbox-current">1</span> / <span id="lightbox-total">{photos.length}</span>
  </div>

  <!-- Info toggle button (top right, next to close) -->
  <button 
    id="lightbox-info-toggle"
    class="absolute top-4 right-16 z-10 w-10 h-10 flex items-center justify-center text-white/80 hover:text-white transition-all duration-200"
    aria-label="Toggle info panel"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
  </button>

  <!-- Navigation arrows -->
  <button 
    id="lightbox-prev"
    class="absolute left-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 flex items-center justify-center text-white/60 hover:text-white transition-colors"
    aria-label="Previous image"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <button 
    id="lightbox-next"
    class="absolute right-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 flex items-center justify-center text-white/60 hover:text-white transition-all duration-300"
    aria-label="Next image"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <!-- Main image container -->
  <div id="lightbox-image-container" class="absolute inset-0 flex items-center justify-center p-16 pb-24 md:p-20 md:pb-28 transition-all duration-300">
    <!-- Pre-rendered Astro Image components for each photo -->
    {photos.map((photo) => (
      <div 
        id={`lightbox-image-${photo.id}`}
        class="hidden w-full h-full flex items-center justify-center"
        data-photo-id={photo.id}
      >
        <Image
          src={imageSources[photo.id as PhotoId]}
          alt={photo.title}
          class="max-w-full max-h-full object-contain transition-opacity duration-300"
          quality="high"
          widths={[800, 1200, 1600, 2000]}
          sizes="(max-width: 768px) 90vw, (max-width: 1024px) 80vw, 70vw"
          loading="lazy"
        />
      </div>
    ))}
  </div>

  <!-- Title and location overlay (bottom left) -->
  <div id="lightbox-caption" class="absolute bottom-6 left-6 z-10 max-w-md">
    <h2 id="lightbox-title" class="text-white text-lg font-medium mb-1 drop-shadow-lg"></h2>
    <p id="lightbox-location" class="text-white/80 text-sm drop-shadow-lg"></p>
  </div>

  <!-- Info side panel -->
  <div 
    id="lightbox-info-panel" 
    class="absolute top-0 right-0 h-full w-80 bg-black/90 backdrop-blur-md transform translate-x-full transition-transform duration-300 z-20 overflow-y-auto"
  >
    <!-- Close button for panel -->
    <button 
      id="lightbox-info-close"
      class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center text-white/60 hover:text-white transition-colors rounded-full hover:bg-white/10"
      aria-label="Close info panel"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="p-6 space-y-6">
      <h3 class="text-white text-base font-medium border-b border-white/20 pb-3">Image Information</h3>
      
      <!-- Photo Details -->
      <div class="space-y-4">
        <div>
          <h4 class="text-white/50 text-xs uppercase tracking-wide mb-2">Photo</h4>
          <p id="info-panel-title" class="text-white text-sm"></p>
          <p id="info-panel-location" class="text-white/70 text-xs mt-1"></p>
        </div>

        <!-- EXIF Data -->
        <div id="info-panel-exif">
          <h4 class="text-white/50 text-xs uppercase tracking-wide mb-2">Camera Settings</h4>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-white/60">Camera</span>
              <span id="exif-camera" class="text-white"></span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/60">Lens</span>
              <span id="exif-lens" class="text-white"></span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/60">Focal Length</span>
              <span id="exif-focal" class="text-white"></span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/60">Aperture</span>
              <span id="exif-aperture" class="text-white"></span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/60">Shutter Speed</span>
              <span id="exif-shutter" class="text-white"></span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/60">ISO</span>
              <span id="exif-iso" class="text-white"></span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/60">Date Taken</span>
              <span id="exif-date" class="text-white"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Store photo data for JavaScript -->
<script define:vars={{ photoData }}>
  window.__lightboxPhotos = photoData;
</script>

<script>
  interface PhotoData {
    id: string;
    title: string;
    location: string;
    exif: {
      camera?: string;
      lens?: string;
      focalLength?: string;
      aperture?: string;
      shutterSpeed?: string;
      iso?: string;
      dateTaken?: string;
    };
    index: number;
  }

  // Get photo data from the server-rendered script
  const allPhotos: PhotoData[] = (window as any).__lightboxPhotos || [];
  
  // Current state
  let currentIndex = 0;
  let filteredPhotos: PhotoData[] = [...allPhotos];
  let isOpen = false;
  let isInfoPanelOpen = false;

  // DOM elements
  const lightbox = document.getElementById('lightbox');
  const lightboxImageContainer = document.getElementById('lightbox-image-container');
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxLocation = document.getElementById('lightbox-location');
  const lightboxCurrent = document.getElementById('lightbox-current');
  const lightboxTotal = document.getElementById('lightbox-total');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');
  const infoToggleBtn = document.getElementById('lightbox-info-toggle');
  const infoCloseBtn = document.getElementById('lightbox-info-close');
  const infoPanel = document.getElementById('lightbox-info-panel');
  
  // Info panel elements
  const infoPanelTitle = document.getElementById('info-panel-title');
  const infoPanelLocation = document.getElementById('info-panel-location');
  const exifCamera = document.getElementById('exif-camera');
  const exifLens = document.getElementById('exif-lens');
  const exifFocal = document.getElementById('exif-focal');
  const exifAperture = document.getElementById('exif-aperture');
  const exifShutter = document.getElementById('exif-shutter');
  const exifIso = document.getElementById('exif-iso');
  const exifDate = document.getElementById('exif-date');

  function updateLightbox() {
    if (!filteredPhotos.length) return;
    
    const photo = filteredPhotos[currentIndex];
    if (!photo) return;

    // Hide all image containers and show only the current one
    const allImageContainers = lightboxImageContainer?.querySelectorAll('[data-photo-id]');
    allImageContainers?.forEach((container) => {
      if (container.getAttribute('data-photo-id') === photo.id) {
        container.classList.remove('hidden');
      } else {
        container.classList.add('hidden');
      }
    });

    // Update caption
    if (lightboxTitle) lightboxTitle.textContent = photo.title;
    if (lightboxLocation) lightboxLocation.textContent = photo.location;
    if (lightboxCurrent) lightboxCurrent.textContent = (currentIndex + 1).toString();
    if (lightboxTotal) lightboxTotal.textContent = filteredPhotos.length.toString();

    // Update info panel
    if (infoPanelTitle) infoPanelTitle.textContent = photo.title;
    if (infoPanelLocation) infoPanelLocation.textContent = photo.location;
    if (exifCamera) exifCamera.textContent = photo.exif.camera || '—';
    if (exifLens) exifLens.textContent = photo.exif.lens || '—';
    if (exifFocal) exifFocal.textContent = photo.exif.focalLength || '—';
    if (exifAperture) exifAperture.textContent = photo.exif.aperture || '—';
    if (exifShutter) exifShutter.textContent = photo.exif.shutterSpeed || '—';
    if (exifIso) exifIso.textContent = photo.exif.iso || '—';
    if (exifDate) exifDate.textContent = photo.exif.dateTaken || '—';
  }

  function toggleInfoPanel() {
    isInfoPanelOpen = !isInfoPanelOpen;
    updateInfoPanelState();
  }

  function closeInfoPanel() {
    if (isInfoPanelOpen) {
      isInfoPanelOpen = false;
      updateInfoPanelState();
    }
  }

  function updateInfoPanelState() {
    if (isInfoPanelOpen) {
      // Show panel
      infoPanel?.classList.remove('translate-x-full');
      // Shift image container to the left
      if (lightboxImageContainer) {
        lightboxImageContainer.style.right = '320px'; // 80 * 4 = 320px (w-80 = 20rem)
      }
      // Move next button to stay visible between panel and image
      if (nextBtn) {
        nextBtn.style.right = '336px'; // 320px (panel width) + 16px (original right-4)
      }
      // Add visual feedback to toggle button
      infoToggleBtn?.classList.add('bg-white/20', 'text-white');
      infoToggleBtn?.classList.remove('text-white/80');
    } else {
      // Hide panel
      infoPanel?.classList.add('translate-x-full');
      // Reset image container
      if (lightboxImageContainer) {
        lightboxImageContainer.style.right = '0';
      }
      // Reset next button position
      if (nextBtn) {
        nextBtn.style.right = '1rem'; // Back to right-4 (1rem = 16px)
      }
      // Remove visual feedback from toggle button
      infoToggleBtn?.classList.remove('bg-white/20', 'text-white');
      infoToggleBtn?.classList.add('text-white/80');
    }
  }

  function openLightbox(photoId: string, visiblePhotoIds?: string[]) {
    // If visiblePhotoIds provided, filter to only those photos
    if (visiblePhotoIds && visiblePhotoIds.length > 0) {
      filteredPhotos = allPhotos.filter(p => visiblePhotoIds.includes(p.id));
    } else {
      filteredPhotos = [...allPhotos];
    }

    // Find the index of the clicked photo in the filtered list
    currentIndex = filteredPhotos.findIndex(p => p.id === photoId);
    if (currentIndex === -1) currentIndex = 0;

    if (lightbox) {
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      isOpen = true;
      updateLightbox();
    }
  }

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
      isOpen = false;
      
      // Close info panel if open
      closeInfoPanel();
    }
  }

  function navigate(direction: 'prev' | 'next') {
    if (!filteredPhotos.length) return;
    
    if (direction === 'prev') {
      currentIndex = currentIndex > 0 ? currentIndex - 1 : filteredPhotos.length - 1;
    } else {
      currentIndex = currentIndex < filteredPhotos.length - 1 ? currentIndex + 1 : 0;
    }
    updateLightbox();
  }

  // Event listeners
  closeBtn?.addEventListener('click', closeLightbox);
  infoToggleBtn?.addEventListener('click', toggleInfoPanel);
  infoCloseBtn?.addEventListener('click', closeInfoPanel);
  prevBtn?.addEventListener('click', () => navigate('prev'));
  nextBtn?.addEventListener('click', () => navigate('next'));

  // Close info panel when clicking outside of it (on the backdrop or image)
  lightbox?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    
    // Close entire lightbox if clicking on backdrop or image container (empty space)
    if (target === lightbox || 
        target.id === 'lightbox' || 
        target.id === 'lightbox-image-container' ||
        target === lightboxImageContainer) {
      closeLightbox();
      return;
    }
    
    // Close info panel if it's open and click is outside the panel
    // Don't close when clicking navigation buttons
    if (isInfoPanelOpen && 
        !infoPanel?.contains(target) && 
        !infoToggleBtn?.contains(target) &&
        !nextBtn?.contains(target) &&
        !prevBtn?.contains(target)) {
      closeInfoPanel();
    }
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (!isOpen) return;
    
    switch (e.key) {
      case 'Escape':
        // Close info panel first if open, otherwise close lightbox
        if (isInfoPanelOpen) {
          closeInfoPanel();
        } else {
          closeLightbox();
        }
        break;
      case 'ArrowLeft':
        navigate('prev');
        break;
      case 'ArrowRight':
        navigate('next');
        break;
      case 'i':
      case 'I':
        // Toggle info panel with 'i' key
        toggleInfoPanel();
        break;
    }
  });

  // Listen for gallery image clicks
  document.addEventListener('click', (e) => {
    const wrapper = (e.target as HTMLElement).closest('.gallery-image-wrapper');
    if (wrapper) {
      const photoId = wrapper.getAttribute('data-photo-id');
      if (photoId) {
        // Get currently visible photo IDs (for filtered navigation)
        // Check if parent .gallery-item has .hidden class
        const visibleItems = document.querySelectorAll('.gallery-item:not(.hidden) .gallery-image-wrapper');
        const visibleIds = Array.from(visibleItems).map(el => el.getAttribute('data-photo-id')).filter(Boolean) as string[];
        openLightbox(photoId, visibleIds);
      }
    }
  });

  // Expose functions globally for external control
  (window as any).openLightbox = openLightbox;
  (window as any).closeLightbox = closeLightbox;
</script>
