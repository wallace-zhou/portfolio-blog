---
import { Image } from 'astro:assets';
import type { PhotoMetadata, PhotoId } from '../data/photos';
import { imageSources } from '../data/photos';

interface Props {
  photo: PhotoMetadata;
  index: number;
  class?: string;
  loading?: 'eager' | 'lazy';
  sizes?: string;
}

const { photo, index, class: className = '', loading = 'lazy', sizes = '33vw' } = Astro.props;

const imageSrc = imageSources[photo.id as PhotoId];
---

<div 
  class:list={['gallery-image-wrapper group cursor-pointer relative overflow-hidden', className]}
  data-photo-id={photo.id}
  data-photo-index={index}
>
  <Image
    src={imageSrc}
    alt={photo.title}
    class="w-full h-auto transition-transform duration-700 group-hover:scale-105"
    quality="high"
    widths={[400, 800, 1200, 1600, 2000]}
    sizes={sizes}
    loading={loading}
  />
  
  <!-- Hover overlay - dark gradient bar at bottom -->
  <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-black/70 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
    <div class="absolute bottom-0 left-0 right-0 p-4">
      <h3 class="text-white text-sm font-medium truncate">{photo.title}</h3>
      <p class="text-white/70 text-xs truncate">{photo.location}</p>
    </div>
  </div>
</div>

<style>
  .gallery-image-wrapper {
    /* Ensure image fills container properly */
    display: block;
  }
  
  .gallery-image-wrapper img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
