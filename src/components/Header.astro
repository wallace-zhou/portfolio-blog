---
// Header component with logo - no fade effects
---

<style>
  .logo-svg {
    filter: brightness(0) invert(1);
  }
  .header-logo:hover .logo-svg path {
    fill: rgba(255, 255, 255, 1);
  }
  .logo-svg path {
    transition: fill 700ms;
  }
</style>

<header class="w-full bg-primary">
  <div id="hero-top-logo" class="flex justify-center py-[26px]">
    <a
      href="/"
      class="header-logo flex flex-col items-center transition-all duration-700"
      aria-label="周庭徵 logo"
    >
      <img
        src="/logo-ztz.svg"
        alt="周庭徵 signature logo"
        class="h-12 md:h-16 w-auto logo-svg"
      />
      <span class="text-background text-body-base style-label mt-2" style="letter-spacing: 0.2em;">WALLACE ZHOU</span>
    </a>
  </div>
</header>
