---
// Header component with logo - no fade effects
---

<style>
  .logo-svg {
    filter: brightness(0) invert(1);
  }
  .header-logo:hover .logo-svg path {
    fill: rgba(255, 255, 255, 1);
  }
  .logo-svg path {
    transition: fill 700ms;
  }
</style>

<header id="site-header" class="w-full bg-primary relative z-[110]">
  <div id="hero-top-logo" class="flex justify-between items-center py-4 md:py-[26px] pl-16 pr-6 md:pl-28 md:pr-4">
    <a
      href="/"
      class="header-logo flex flex-col items-start transition-all duration-700"
      aria-label="周庭徵 logo"
    >
      <img
        src="/logo-ztz.svg"
        alt="周庭徵 signature logo"
        class="h-12 md:h-16 w-auto logo-svg"
      />
    </a>
    <a
      href="/"
      class="header-logo flex flex-col items-center transition-all duration-700"
      aria-label="Wallace Zhou"
    >
      <span class="text-background text-body style-label" style="letter-spacing: 0.2em;">WALLACE ZHOU</span>
    </a>
  </div>
</header>

<script>
  function updateHeaderHeight() {
    const header = document.getElementById('site-header');
    if (header) {
      const height = header.offsetHeight;
      document.documentElement.style.setProperty('--header-height', `${height}px`);
    }
  }

  // Update on load and resize
  window.addEventListener('load', updateHeaderHeight);
  window.addEventListener('resize', updateHeaderHeight);
  
  // Initial call
  updateHeaderHeight();
</script>
