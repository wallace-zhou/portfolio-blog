---
const navLinks = [
  { label: "Gallery", href: "/gallery" },
  { label: "Journal", href: "/blog" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "#contact" },
];
---

<style>
  #nav-logo img {
    filter: brightness(0) invert(1);
  }
</style>

<!-- Desktop Sidebar -->
<nav 
  id="desktop-nav"
  transition:persist="desktop-nav"
  class="fixed left-0 top-0 h-screen w-28 z-[var(--z-sidebar)] hidden md:flex flex-col items-center py-8 bg-primary"
>
  <!-- Logo - only visible after scrolling past hero -->
  <a 
    href="#"
    id="nav-logo"
    class="absolute top-8 left-1/2 -translate-x-1/2 transition-all duration-500 opacity-0 -translate-y-2 pointer-events-none"
  >
    <img
      src="/logo-z.svg"
      alt="Wallace Z signature logo"
      class="h-12 md:h-16 w-auto"
    />
  </a>

  <!-- Horizontal Nav Links - positioned in upper half -->
  <div class="mt-[calc(var(--header-height,160px)-32px)] px-4 flex flex-col items-center gap-10">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="nav-link text-small style-nav transition-colors duration-300 hover:opacity-100 text-background/70 hover:text-background"
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>

<!-- Mobile Header -->
<header id="mobile-header" transition:persist="mobile-header" class="fixed top-0 left-0 right-0 z-[var(--z-mobile-header)] md:hidden pointer-events-none">
  <div id="mobile-header-bg" class="relative flex items-center justify-between px-6 py-4 transition-colors duration-500 bg-transparent">
    <!-- Menu Toggle - on the left -->
    <button 
      id="menu-toggle"
      class="text-background p-2 relative z-10 pointer-events-auto"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <div class="w-6 flex flex-col gap-1.5">
        <span id="menu-line-1" class="block h-px bg-current transition-transform duration-300"></span>
        <span id="menu-line-2" class="block h-px bg-current transition-opacity duration-300"></span>
        <span id="menu-line-3" class="block h-px bg-current transition-transform duration-300"></span>
      </div>
    </button>

    <!-- Logo - only visible after scrolling past hero -->
    <a 
      href="/"
      id="mobile-logo"
      class="transition-all duration-500 opacity-0 -translate-y-2 pointer-events-none relative z-10"
    >
      <img
        src="/logo-z.svg"
        alt="Wallace Z signature logo"
        class="h-12 w-auto"
      />
    </a>
  </div>

  <!-- Mobile Menu Backdrop -->
  <div 
    id="mobile-menu-backdrop" 
    class="fixed inset-0 z-[var(--z-mobile-backdrop)] bg-black/50 transition-opacity duration-500 opacity-0 pointer-events-none"
  ></div>

  <!-- Mobile Menu Sidebar -->
  <div id="mobile-menu" class="fixed left-0 top-0 bottom-0 w-[70%] z-[var(--z-mobile-menu)] bg-primary transition-transform duration-500 -translate-x-full pointer-events-none">
    <div class="flex flex-col items-center justify-center h-full gap-12">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link text-heading style-cta style-heading-bold text-background/80 hover:text-background transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  let isMobileMenuOpen = false;
  let mobileMenuInitialized = false;
  let currentObserver: IntersectionObserver | null = null;
  let currentScrollHandler: ((e: Event) => void) | null = null;

  function closeMobileMenu() {
    if (!isMobileMenuOpen) return;
    isMobileMenuOpen = false;

    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuBackdrop = document.getElementById('mobile-menu-backdrop');
    const menuLine1 = document.getElementById('menu-line-1');
    const menuLine2 = document.getElementById('menu-line-2');
    const menuLine3 = document.getElementById('menu-line-3');

    if (menuToggle) menuToggle.setAttribute('aria-expanded', 'false');

    if (mobileMenu) {
      mobileMenu.classList.remove('translate-x-0', 'pointer-events-auto');
      mobileMenu.classList.add('-translate-x-full', 'pointer-events-none');
    }

    if (mobileMenuBackdrop) {
      mobileMenuBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
      mobileMenuBackdrop.classList.add('opacity-0', 'pointer-events-none');
    }

    if (menuLine1 && menuLine2 && menuLine3) {
      menuLine1.classList.remove('rotate-45', 'translate-y-2');
      menuLine2.classList.remove('opacity-0');
      menuLine3.classList.remove('-rotate-45', '-translate-y-2');
    }
  }

  function toggleMobileMenu() {
    isMobileMenuOpen = !isMobileMenuOpen;

    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuBackdrop = document.getElementById('mobile-menu-backdrop');
    const menuLine1 = document.getElementById('menu-line-1');
    const menuLine2 = document.getElementById('menu-line-2');
    const menuLine3 = document.getElementById('menu-line-3');

    if (menuToggle) menuToggle.setAttribute('aria-expanded', isMobileMenuOpen.toString());

    if (mobileMenu) {
      if (isMobileMenuOpen) {
        mobileMenu.classList.remove('-translate-x-full', 'pointer-events-none');
        mobileMenu.classList.add('translate-x-0', 'pointer-events-auto');
      } else {
        mobileMenu.classList.remove('translate-x-0', 'pointer-events-auto');
        mobileMenu.classList.add('-translate-x-full', 'pointer-events-none');
      }
    }

    if (mobileMenuBackdrop) {
      if (isMobileMenuOpen) {
        mobileMenuBackdrop.classList.remove('opacity-0', 'pointer-events-none');
        mobileMenuBackdrop.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        mobileMenuBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
        mobileMenuBackdrop.classList.add('opacity-0', 'pointer-events-none');
      }
    }

    if (menuLine1 && menuLine2 && menuLine3) {
      if (isMobileMenuOpen) {
        menuLine1.classList.add('rotate-45', 'translate-y-2');
        menuLine2.classList.add('opacity-0');
        menuLine3.classList.add('-rotate-45', '-translate-y-2');
      } else {
        menuLine1.classList.remove('rotate-45', 'translate-y-2');
        menuLine2.classList.remove('opacity-0');
        menuLine3.classList.remove('-rotate-45', '-translate-y-2');
      }
    }
  }

  function setupMobileMenuListeners() {
    if (mobileMenuInitialized) return;
    mobileMenuInitialized = true;

    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenuBackdrop = document.getElementById('mobile-menu-backdrop');

    if (menuToggle) menuToggle.addEventListener('click', toggleMobileMenu);
    if (mobileMenuBackdrop) mobileMenuBackdrop.addEventListener('click', closeMobileMenu);

    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', closeMobileMenu);
    });
  }

  function setupPageBehavior() {
    if (currentObserver) {
      currentObserver.disconnect();
      currentObserver = null;
    }
    if (currentScrollHandler) {
      window.removeEventListener('scroll', currentScrollHandler);
      currentScrollHandler = null;
    }

    const navLogo = document.getElementById('nav-logo');
    const mobileHeaderBg = document.getElementById('mobile-header-bg');
    const mobileLogo = document.getElementById('mobile-logo');
    const heroTopLogo = document.getElementById('hero-top-logo');

    let isHeroLogoVisible = true;

    function updateNavLogoVisibility() {
      const showNavLogo = !isHeroLogoVisible;

      if (navLogo) {
        if (showNavLogo) {
          navLogo.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
          navLogo.classList.add('opacity-100', 'translate-y-0');
        } else {
          navLogo.classList.remove('opacity-100', 'translate-y-0');
          navLogo.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
        }
      }

      if (mobileLogo) {
        if (showNavLogo) {
          mobileLogo.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
          mobileLogo.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        } else {
          mobileLogo.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
          mobileLogo.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
        }
      }
    }

    function handleScroll() {
      const scrollY = window.scrollY;
      const isScrolled = scrollY > 100;

      if (mobileHeaderBg && heroTopLogo) {
        if (isScrolled) {
          mobileHeaderBg.classList.remove('bg-transparent');
          mobileHeaderBg.classList.add('bg-primary');
        } else {
          mobileHeaderBg.classList.remove('bg-primary');
          mobileHeaderBg.classList.add('bg-transparent');
        }
      }
    }

    if (heroTopLogo) {
      currentObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isHeroLogoVisible = entry.isIntersecting;
            updateNavLogoVisibility();
          });
        },
        { threshold: 0, rootMargin: '0px' }
      );
      currentObserver.observe(heroTopLogo);
    } else {
      isHeroLogoVisible = false;
      updateNavLogoVisibility();
      if (mobileHeaderBg) {
        mobileHeaderBg.classList.remove('bg-transparent');
        mobileHeaderBg.classList.add('bg-primary');
      }
    }

    currentScrollHandler = handleScroll;
    window.addEventListener('scroll', handleScroll, { passive: true });

    handleScroll();
    updateNavLogoVisibility();
  }

  document.addEventListener('astro:before-swap', closeMobileMenu);

  document.addEventListener('astro:page-load', () => {
    setupMobileMenuListeners();
    setupPageBehavior();
  });
</script>
