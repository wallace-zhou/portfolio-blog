---
import { Image } from 'astro:assets';
import gallery1 from '../assets/blog-placeholder-1.jpg';
import gallery2 from '../assets/blog-placeholder-2.jpg';
import gallery3 from '../assets/blog-placeholder-3.jpg';
import gallery4 from '../assets/blog-placeholder-4.jpg';
import gallery5 from '../assets/blog-placeholder-5.jpg';
import gallery6 from '../assets/blog-placeholder-about.jpg';

const galleryImages = [
  { src: gallery1, alt: "Portrait in dramatic lighting" },
  { src: gallery2, alt: "Minimalist architecture" },
  { src: gallery3, alt: "Misty forest at dawn" },
  { src: gallery4, alt: "Still life with ceramics" },
  { src: gallery5, alt: "Urban street scene" },
  { src: gallery6, alt: "Serene ocean seascape" },
];
---

<style>
  .logo-svg {
    filter: brightness(0) invert(1);
  }
  .hero-logo:hover .logo-svg path {
    fill: rgba(255, 255, 255, 1);
  }
  .logo-svg path {
    transition: fill 700ms;
  }
</style>

<section 
  id="work"
  class="relative w-full overflow-hidden bg-primary"
  style="height: fit-content;"
>
  <!-- Top Logo - Small and Centered on entire page -->
  <div 
    id="hero-top-logo"
    class="absolute top-8 left-0 right-0 z-20 flex justify-center"
  >
    <a
      href="#"
      class="hero-logo transition-all duration-700 opacity-0 -translate-y-4"
      aria-label="周庭徵 logo"
    >
      <img
        src="/logo-ztz.svg"
        alt="周庭徵 signature logo"
        class="h-20 md:h-24 w-auto logo-svg"
      />
      <span class="sr-only">周庭徵</span>
    </a>
  </div>

  <!-- Photo Grid Gallery -->
  <div 
    id="hero-gallery"
    class="pt-36 md:pt-40 pb-0 px-2 md:pl-27 md:pr-4"
  >
    <div class="columns-1 md:columns-3 gap-4 md:gap-6 w-full mb-0">
      {galleryImages.map((image, index) => (
        <div 
          class="gallery-item relative overflow-hidden group cursor-pointer transition-all duration-700 opacity-0 translate-y-8 mb-4 md:mb-6 break-inside-avoid"
          style={`transition-delay: ${index * 100}ms;`}
          data-index={index}
        >
          <Image
            src={image.src}
            alt={image.alt}
            class="w-full h-auto transition-transform duration-700 group-hover:scale-105"
            quality="mid"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 50vw, 33vw"
            loading={index < 3 ? "eager" : "lazy"}
          />
          <!-- Hover overlay -->
          <div class="absolute inset-0 bg-primary/0 group-hover:bg-primary/15 transition-colors duration-500"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Individual image parallax and fade-in animation
  const heroTopLogo = document.getElementById('hero-top-logo');
  const heroLogo = document.querySelector('.hero-logo');
  const galleryItems = document.querySelectorAll('.gallery-item');

  // Initial fade-in animation
  function initFadeIn() {
    setTimeout(() => {
      if (heroLogo) {
        heroLogo.classList.remove('opacity-0', '-translate-y-4');
        heroLogo.classList.add('opacity-100', 'translate-y-0');
      }
      
      galleryItems.forEach((item) => {
        item.classList.remove('opacity-0', 'translate-y-8');
        item.classList.add('opacity-100', 'translate-y-0');
      });
    }, 100);
  }

  // Logo fade effect on scroll
  function handleScroll() {
    const scrollY = window.scrollY;
    const logoOpacity = Math.max(0, 1 - scrollY / 600);

    // Update logo opacity
    if (heroTopLogo) {
      heroTopLogo.style.opacity = logoOpacity.toString();
    }
  }

  // Event listeners
  window.addEventListener('scroll', handleScroll, { passive: true });
  
  // Initialize
  initFadeIn();
  handleScroll();
</script>
