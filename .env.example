# Public URL for serving images (used at build time by Astro)
PUBLIC_IMAGE_BASE_URL=https://<account-id>.r2.dev

# R2 S3-compatible API credentials (used only by scripts/sync-r2.js)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<your-access-key-id>
R2_SECRET_ACCESS_KEY=<your-secret-access-key>
R2_BUCKET_NAME=<your-bucket-name>
